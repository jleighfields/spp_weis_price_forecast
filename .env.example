# cloudflare id and key
# these are saved as aws secrets in modal for jobs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_S3_BUCKET=spp-rto
# Folder prefix inside the bucket (legacy from the Databricks Unity Catalog
# layout). The code concatenates it directly ahead of object paths with NO
# separator (e.g. f"s3://{AWS_S3_BUCKET}/{AWS_S3_FOLDER}data/"), so it must
# be "" (empty string = data at the bucket root, the current layout) or a
# prefix that ends with a trailing slash, e.g. "my-folder/". Keep the key
# defined even when empty so every environment (.env, Modal aws-secret,
# Posit Connect) declares the same key set.
AWS_S3_FOLDER=""
S3_ENDPOINT_URL=
